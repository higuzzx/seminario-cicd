# Copie para config.env e preencha ANTES de rodar o setup.sh
#   cp config.env.example config.env && nano config.env

# Domínio base. Sem domínio próprio, use o sslip.io com o Elastic IP (troque pontos por traços):
# cliente-a.18-118-57-123.sslip.io  →  aponta para 18.118.57.123 automaticamente
DOMINIO=18-118-57-123.sslip.io

# E-mail para o Let's Encrypt (avisos de expiração de certificado)
ACME_EMAIL=seu-email@exemplo.com

# Usuário do Docker Hub onde o pipeline publica a imagem (repositório público)
DOCKERHUB_USERNAME=seu-usuario-dockerhub

# Login dos painéis (Traefik, Dozzle, Prometheus)
PAINEL_USER=admin
PAINEL_SENHA=troque-esta-senha

# Senha do admin do Grafana
GRAFANA_SENHA=troque-esta-senha-tambem

# Chave PÚBLICA usada pelo GitHub Actions para entrar no servidor (conteúdo do github_deploy.pub)
DEPLOY_PUBKEY="ssh-ed25519 AAAA... github-actions"

# Clientes a criar (separados por espaço) e a cor de cada um na página
CLIENTES="cliente-a cliente-b"
COR_cliente_a="#2563eb"
COR_cliente_b="#16a34a"
